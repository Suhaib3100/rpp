# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Dataset images are redistributable only from the original source; the
# manifest, label map and split files ARE committed so the splits are
# reproducible without redistributing the images themselves.
data/raw/images/
data/raw/*.parquet

# Training artefacts. Checkpoints are large; result.json / history.json are
# the reproducible record and are kept.
experiments/**/*.pt
experiments/optuna/
mlruns/
logs/

# Rendered intermediates (regenerated by scripts/render_slides.py)
presentation/rendered/
presentation/**/_pdf/

# Scratch
.context/attachments/
.context/verify/

# Slide-image resampling cache (regenerated by make_presentation.py)
.cache_slide_images/

# Keep checkpoints/ — those are the slim, inference-ready weights exported by
# scripts/export_checkpoints.py. Only the fat training checkpoints under
# experiments/ are excluded, above.
